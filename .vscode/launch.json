{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug BE",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/backend/cmd/server",
            "env": {
                "LEXFORGE_SERVER_ADDRESS": "localhost:5656",
                "LEXFORGE_MAX_SESSIONS_PER_DAY": "1",
                "LEXFORGE_MIGRATE_DATABASE": "false",
                "LEXFORGE_DATABASE_DSN": "lexforge:lexforge@tcp(localhost:3306)/lexforge?charset=utf8mb4&parseTime=True&loc=Local",
                "LEXFORGE_AUTH0_DOMAIN": "[AUTH0 DOMAIN GOES HERE]",
                "LEXFORGE_AUTH0_AUDIENCE": "http://localhost:5656"
            }
        },
        {
            "name": "Debug FE",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5757",
            "webRoot": "${workspaceFolder}/frontend",
            "preLaunchTask": "Start FE dev server"
        }
    ]
}